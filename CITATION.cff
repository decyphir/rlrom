    family-names: Donzé
    email: alexandre.donze@univ-grenoble-alpes.fr
    affiliation: "Univ. Grenoble Alpes"
repository-code: "https://github.com/decyphir/rlrom"
url: "https://github.com/decyphir/rlrom"
license: BSD-3-Clause
keywords:
  - reinforcement learning
  - signal temporal logic
  - runtime verification
  - monitoring
  - reward shaping
  - shielding
version: 0.3.0
# date-released: set when the v0.3.0 tag is created

