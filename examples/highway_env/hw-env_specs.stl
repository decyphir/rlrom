signal action, ego_presence, ego_x, ego_y, ego_vx, ego_vy, 
       car1_presence, car1_x, car1_y, car1_vx, car1_vy, 
       car2_presence, car2_x, car2_y, car2_vx, car2_vy, 
       car3_presence, car3_x, car3_y, car3_vx, car3_vy, 
       env_reward

# Speed formulas
ego_moves := ego_vx[t] > 0 # used for evaluation
ego_slow  := ego_vx[t] < 22
ego_fast  := ego_vx[t] > 25

# Danger formulas
param close_dist=0.15, same_lane_dist= 0.24
car1_same_lane  := abs(car1_y[t]) < same_lane_dist
car1_too_close := abs(car1_x[t]) < close_dist 
car1_danger := car1_same_lane and car1_too_close

car2_same_lane  := abs(car2_y[t]) < same_lane_dist
car2_too_close  := abs(car2_x[t]) < close_dist 
car2_danger := car2_same_lane and car2_too_close

car3_same_lane  := abs(car3_y[t]) < same_lane_dist
car3_too_close  := abs(car3_x[t]) < close_dist 
car3_danger := car3_same_lane and car3_too_close

car_same_lane := car1_same_lane or car2_same_lane or car3_same_lane
car_too_close := car1_too_close or car2_too_close or car3_too_close

mu_danger := car1_danger or car2_danger or car3_danger
danger := ev_[0,5] (mu_danger)
no_danger:= not danger


# Right lane formulas
ego_right_lane := ego_y[t] > 0.6
not_right := not ego_right_lane
not_right_too_long := alw_[0,10] (not_right)

ego_left_lane := ego_y[t] < 0.1

# There is a car on the left 
car1_left := car1_y[t] > -.35 and car1_y[t] < -.15 and  abs(car1_x[t])  < .075 
car2_left := car2_y[t] > -.35 and car2_y[t] < -.15 and  abs(car2_x[t]) < .075 
car3_left := car3_y[t] > -.35 and car3_y[t] < -.15 and  abs(car3_x[t]) < .075 
car_left := car1_left or car2_left or car3_left or ego_left_lane
no_car_left := not car_left

# There is a car on the left 
car1_right := car1_y[t] > .15 and car1_y[t] < .35 and abs(car1_x[t])  < .075
car2_right := car2_y[t] > .15 and car2_y[t] < .35 and abs(car2_x[t])  < .075
car3_right := car3_y[t] > .15 and car3_y[t] < .35 and abs(car3_x[t])  < .075
car_right := car1_right or car2_right or car3_right or ego_right_lane
no_car_right := not car_right

# Full episode formulas
phi_speed := alw_[0,50] ev_[0,15] ego_fast 
phi_right_lane := alw_[0,50] ev_[0,15] ego_right_lane
phi_car_left := alw_[0,50] ev_[0,15] (not car_left)

# Reward formulas, shorter

Gda := alw_[0,5] danger
fa_da := danger and ego_fast
fa_n_da := (not danger) and ego_fast
n_fa_n_da :=  not (ego_fast or danger)
Gn_fa_n_da := alw_[0,5] n_fa_n_da